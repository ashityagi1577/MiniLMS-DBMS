# MiniLMS backend configuration - copy this file to ".env" and edit the values.
#   Copy-Item .env.example .env
# NEVER commit the real .env file (it is listed in .gitignore).

# Port the Express server listens on.
PORT=5000

# MySQL connection (credentials used by db.js only - never sent to the browser).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=CHANGE_ME
DB_NAME=MiniLMS

# Demo bootstrap password.
# The seeded rows in 03_insert_sample_data.sql contain PLACEHOLDER password
# hashes (not real bcrypt hashes), so login accepts this password for those
# accounts until their hash is replaced with a real bcrypt hash.
# Accounts created through the API get real bcrypt hashes immediately.
DEMO_PASSWORD=demo123

# How long a login token stays valid (minutes). Expired tokens are rejected.
# The server keeps only a SHA-256 hash of each token, in process memory.
TOKEN_TTL_MINUTES=480

# Login rate limiting (in-memory, per server process - counters reset when the
# server restarts). Only failed password checks are counted; a successful
# sign-in clears the per-account counter.
#   window      - how long a failure is remembered (milliseconds)
#   per account - failures allowed per client IP + e-mail inside the window
#   per IP      - total failures allowed per client IP inside the window
LOGIN_RATE_WINDOW_MS=900000
LOGIN_RATE_MAX_PER_ACCOUNT=5
LOGIN_RATE_MAX_PER_IP=100

# Comma separated list of extra browser origins allowed by CORS.
# (Used when the frontend is opened from file:// or another static server.)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
